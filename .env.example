# Database connection string
POSTGRES_URL=postgresql://127.0.0.1:5432/your-database-name
# Apply schema migrations with pnpm payload migrate. Enable push only against disposable local databases.
PAYLOAD_DB_PUSH=false
# payload reads published CMS content; legacy renders the archived original content without a database.
SITE_CONTENT_SOURCE=payload
# Optional durable media storage. If omitted, uploads use public/media on the server filesystem.
BLOB_READ_WRITE_TOKEN=
# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE
# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
